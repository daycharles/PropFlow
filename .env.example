POSTGRES_DB=propflow
POSTGRES_USER=propflow
POSTGRES_PASSWORD=replace-with-a-random-local-admin-password
APP_DB_PASSWORD=replace-with-a-different-random-runtime-password
# Only enable when the listed reverse proxy IPs are trusted to set these headers.
ForwardedHeaders__Enabled=false
ForwardedHeaders__KnownProxies=
# HMAC secret used by external SMS/email provider delivery callbacks.
Communications__ProviderCallbackSecret=replace-with-a-random-callback-secret
